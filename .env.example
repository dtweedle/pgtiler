# Cloudflare R2 upload configuration (used by scripts/upload-tiles.sh)
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# R2 bucket name (required)
R2_BUCKET=your-bucket-name

# rclone remote name (default: r2)
# Must match the name you used in 'rclone config'
R2_REMOTE=r2

# R2 public URL for preview (optional)
# Used by the preview page to load tiles directly from R2.
# Enable public access on your R2 bucket, then set the URL here.
# Example: https://pub-abc123.r2.dev/squiggly-maps-v1
R2_PUBLIC_URL=
