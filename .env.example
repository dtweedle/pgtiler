# Cloudflare R2 upload configuration (used by scripts/upload-tiles.sh)
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# R2 bucket name (required)
R2_BUCKET=your-bucket-name

# rclone remote name (default: r2)
# Must match the name you used in 'rclone config'
R2_REMOTE=r2

# Public URL the tile worker is served on (used by upload-style.sh and the preview page)
# This is the Worker's custom domain or *.workers.dev URL — NOT the R2 bucket's
# public URL. The bucket itself does not need public access; the worker reads it
# through an R2 binding. See worker/README.md.
# Example: https://maps.example.com
R2_PUBLIC_URL=
