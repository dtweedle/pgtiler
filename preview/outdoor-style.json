{
  "version": 8,
  "name": "Outdoor",
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "sources": {
    "output": {
      "type": "vector",
      "url": "http://localhost:3000/output"
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "background",
      "paint": {
        "background-color": "#e8e0cf"
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "output",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {
        "fill-color": "#dbe5c7",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.2, 10, 0.38, 14, 0.5]
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "output",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#ccd9b5",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.2, 10, 0.38, 14, 0.5]
      }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "output",
      "source-layer": "landcover",
      "filter": ["in", "class", "sand", "rock", "ice"],
      "paint": {
        "fill-color": "#ead9b5",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.2, 10, 0.38, 14, 0.5]
      }
    },
    {
      "id": "landcover-other",
      "type": "fill",
      "source": "output",
      "source-layer": "landcover",
      "filter": ["!in", "class", "grass", "wood", "sand", "rock", "ice"],
      "paint": {
        "fill-color": "#e3dccd",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.2, 10, 0.38, 14, 0.5]
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "output",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": {
        "fill-color": "#e8dfcf",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.05, 10, 0.18, 14, 0.26]
      }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "output",
      "source-layer": "landuse",
      "filter": ["in", "class", "commercial", "industrial", "retail"],
      "paint": {
        "fill-color": "#ddd1bc",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.05, 10, 0.18, 14, 0.26]
      }
    },
    {
      "id": "landuse-cemetery",
      "type": "fill",
      "source": "output",
      "source-layer": "landuse",
      "filter": ["==", "class", "cemetery"],
      "paint": {
        "fill-color": "#e2d7c7",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.05, 10, 0.18, 14, 0.26]
      }
    },
    {
      "id": "landuse-hospital",
      "type": "fill",
      "source": "output",
      "source-layer": "landuse",
      "filter": ["==", "class", "hospital"],
      "paint": {
        "fill-color": "#e2d7c7",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.05, 10, 0.18, 14, 0.26]
      }
    },
    {
      "id": "landuse-school",
      "type": "fill",
      "source": "output",
      "source-layer": "landuse",
      "filter": ["in", "class", "school", "university"],
      "paint": {
        "fill-color": "#e2d7c7",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.05, 10, 0.18, 14, 0.26]
      }
    },
    {
      "id": "park-fill",
      "type": "fill",
      "source": "output",
      "source-layer": "park",
      "paint": {
        "fill-color": "#cfe0bb",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.18, 10, 0.28, 14, 0.34]
      }
    },
    {
      "id": "park-outline",
      "type": "line",
      "source": "output",
      "source-layer": "park",
      "minzoom": 9,
      "paint": {
        "line-color": "#a8c48a",
        "line-width": 1,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "water-fill",
      "type": "fill",
      "source": "output",
      "source-layer": "water",
      "paint": {
        "fill-color": "#8eaec4",
        "fill-opacity": 0.92
      }
    },
    {
      "id": "waterway-river",
      "type": "line",
      "source": "output",
      "source-layer": "waterway",
      "filter": ["==", "class", "river"],
      "paint": {
        "line-color": "#6f98b1",
        "line-opacity": 0.9,
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 10, 1.4, 14, 3.5]
      }
    },
    {
      "id": "waterway-stream",
      "type": "line",
      "source": "output",
      "source-layer": "waterway",
      "filter": ["!=", "class", "river"],
      "minzoom": 10,
      "paint": {
        "line-color": "#6f98b1",
        "line-opacity": 0.9,
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 1.5]
      }
    },
    {
      "id": "aeroway-area",
      "type": "fill",
      "source": "output",
      "source-layer": "aeroway",
      "filter": ["==", "$type", "Polygon"],
      "paint": {
        "fill-color": "#dddddd",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "aeroway-line",
      "type": "line",
      "source": "output",
      "source-layer": "aeroway",
      "filter": ["==", "$type", "LineString"],
      "paint": {
        "line-color": "#cccccc",
        "line-width": ["match", ["get", "class"], "runway", 4, "taxiway", 2, 1]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "output",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#9d8f7b",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 2, 0.12, 6, 0.26, 12, 0.38],
        "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.3, 6, 0.7, 12, 1.3],
        "line-dasharray": [4, 3]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "output",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "minzoom": 4,
      "paint": {
        "line-color": "#9d8f7b",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.1, 8, 0.2, 12, 0.3],
        "line-width": 0.8,
        "line-dasharray": [4, 3]
      }
    },
    {
      "id": "building-fill",
      "type": "fill",
      "source": "output",
      "source-layer": "building",
      "minzoom": 12.5,
      "paint": {
        "fill-color": "#d1c3ad",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 12.5, 0.12, 14, 0.34]
      }
    },
    {
      "id": "building-outline",
      "type": "line",
      "source": "output",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "line-color": "#c4b69e",
        "line-width": 0.5
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "minzoom": 5,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f8f2e7",
        "line-opacity": 0.92,
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 2.2, 10, 4.2, 14, 10.5, 18, 20]
      }
    },
    {
      "id": "road-trunk-casing",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "minzoom": 6,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f8f2e7",
        "line-opacity": 0.92,
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 2, 10, 4, 14, 10, 18, 18]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "minzoom": 7,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f8f2e7",
        "line-opacity": 0.92,
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1.8, 10, 3.6, 14, 9, 18, 16]
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "minzoom": 9,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f8f2e7",
        "line-opacity": 0.92,
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1.5, 14, 7, 18, 14]
      }
    },
    {
      "id": "road-tertiary-casing",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["in", "class", "tertiary", "minor"],
      "minzoom": 11,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f7f1e5",
        "line-opacity": 0.9,
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.2, 14, 5.4, 18, 12]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "minzoom": 5,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c98f50",
        "line-opacity": 0.94,
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.1, 10, 2.3, 14, 7.2, 18, 16]
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "minzoom": 6,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c98f50",
        "line-opacity": 0.94,
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 10, 2, 14, 6.5, 18, 14]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "minzoom": 7,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d5aa68",
        "line-opacity": 0.94,
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.6, 10, 1.8, 14, 5.5, 18, 12]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "minzoom": 9,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#dcc389",
        "line-opacity": 0.94,
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 14, 3.5, 18, 10]
      }
    },
    {
      "id": "road-tertiary",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["in", "class", "tertiary", "minor"],
      "minzoom": 11,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c9b49a",
        "line-opacity": 0.92,
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.7, 14, 3.4, 18, 8]
      }
    },
    {
      "id": "road-service",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "service"],
      "minzoom": 13,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c9b49a",
        "line-opacity": 0.92,
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 18, 4]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["in", "class", "path", "track"],
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8e6b49",
        "line-opacity": 0.78,
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 2],
        "line-dasharray": [2, 1.5]
      }
    },
    {
      "id": "road-rail",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "minzoom": 10,
      "paint": {
        "line-color": "#b8b8b8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 14, 1.5]
      }
    },
    {
      "id": "road-rail-dash",
      "type": "line",
      "source": "output",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "minzoom": 10,
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 1],
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "water-name-ocean",
      "type": "symbol",
      "source": "output",
      "source-layer": "water_name",
      "filter": ["==", "$type", "Point"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 12, 8, 16],
        "text-font": ["Open Sans Italic"],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4f7592",
        "text-halo-color": "#e9e4d7",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water-name-line",
      "type": "symbol",
      "source": "output",
      "source-layer": "water_name",
      "filter": ["==", "$type", "LineString"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": 11,
        "text-font": ["Open Sans Italic"],
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#4f7592",
        "text-halo-color": "#e9e4d7",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-label-primary",
      "type": "symbol",
      "source": "output",
      "source-layer": "transportation_name",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "minzoom": 9,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 12, 11, 14, 13],
        "text-font": ["Open Sans Regular"],
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-max-angle": 45,
        "text-letter-spacing": 0.02
      },
      "paint": {
        "text-color": "#715f4c",
        "text-halo-color": "#f4efe7",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "road-label-secondary",
      "type": "symbol",
      "source": "output",
      "source-layer": "transportation_name",
      "filter": ["!in", "class", "motorway", "trunk", "primary"],
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": 10,
        "text-font": ["Open Sans Regular"],
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-max-angle": 45,
        "text-letter-spacing": 0.02
      },
      "paint": {
        "text-color": "#715f4c",
        "text-halo-color": "#f4efe7",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "mountain-peak-point",
      "type": "circle",
      "source": "output",
      "source-layer": "mountain_peak",
      "filter": ["<=", ["get", "rank"], ["step", ["zoom"], 1, 10, 3, 12, 5]],
      "minzoom": 9,
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 9, 2, 14, 4],
        "circle-color": "rgba(105, 105, 95, 1)",
        "circle-stroke-width": 1,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "mountain-peak-label",
      "type": "symbol",
      "source": "output",
      "source-layer": "mountain_peak",
      "filter": ["<=", ["get", "rank"], ["step", ["zoom"], 1, 10, 3, 12, 5]],
      "minzoom": 10,
      "layout": {
        "text-field": ["concat", ["coalesce", ["get", "name:en"], ["get", "name"]], ["case", ["has", "ele"], ["concat", "\n", ["to-string", ["get", "ele"]], " m"], ""]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 10, 12, 12, 14, 13],
        "text-font": ["Open Sans Bold"],
        "text-offset": [0, 1.2],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#6a4b2d",
        "text-halo-color": "#efe9de",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "output",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": 10,
        "text-font": ["Open Sans Regular"],
        "text-offset": [0, 0.8],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#5d5245",
        "text-halo-color": "#f3eee6",
        "text-halo-width": 1
      }
    },
    {
      "id": "aerodrome-label",
      "type": "symbol",
      "source": "output",
      "source-layer": "aerodrome_label",
      "minzoom": 9,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 14, 12],
        "text-font": ["Open Sans Bold"],
        "text-letter-spacing": 0.08,
        "text-offset": [0, 0.8],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#4d5965",
        "text-halo-color": "#f1eee8",
        "text-halo-width": 1
      }
    },
    {
      "id": "housenumber-label",
      "type": "symbol",
      "source": "output",
      "source-layer": "housenumber",
      "minzoom": 17,
      "layout": {
        "text-field": ["get", "housenumber"],
        "text-size": 9,
        "text-font": ["Open Sans Regular"]
      },
      "paint": {
        "text-color": "#8a7e6f",
        "text-halo-color": "#f3eee6",
        "text-halo-width": 0.8
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "output",
      "source-layer": "place",
      "filter": ["==", "class", "country"],
      "maxzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 13, 7, 17, 14, 20],
        "text-font": ["Open Sans Bold"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.06,
        "text-max-width": 6
      },
      "paint": {
        "text-color": "#3c332a",
        "text-halo-color": "#f3eee6",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "output",
      "source-layer": "place",
      "filter": ["==", "class", "state"],
      "minzoom": 4,
      "maxzoom": 10,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 7, 14, 14, 18],
        "text-font": ["Open Sans Bold"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.06,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3c332a",
        "text-halo-color": "#f3eee6",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "output",
      "source-layer": "place",
      "filter": ["==", "class", "city"],
      "minzoom": 4,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 0, 7, 13, 14, 17],
        "text-font": ["Open Sans Bold"],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3c332a",
        "text-halo-color": "#f3eee6",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "output",
      "source-layer": "place",
      "filter": ["==", "class", "town"],
      "minzoom": 7,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 11, 14, 14],
        "text-font": ["Open Sans Bold"],
