# Tile archives — large (100MB–20GB), regenerate via scripts/generate-*-tiles.sh
# Ignored wholesale: nothing in here belongs in git.
tiles/

# Raw datasets and Planetiler temp files — large, reproduce via scripts
datasets/sources/
datasets/tmp/

# Environment / secrets
.env
.env.local

# Generated preview config (created by preview.sh from .env)
preview/config.js

# Obsidian — share the vault settings, ignore per-machine state
.obsidian/*
!.obsidian/app.json

# Python bytecode (scripts/check-terrain.py)
__pycache__/

# macOS
.DS_Store

# Cloudflare Worker build/state
worker/node_modules/
worker/.wrangler/
