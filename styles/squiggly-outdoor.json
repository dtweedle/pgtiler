      "type": "symbol",
      "source": "base",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "concat",
          [
            "coalesce",
            ["get", "name:en"],
            ["get", "name"]
          ],
          [
            "case",
            ["has", "ele"],
            [
              "concat",
              "\n",
              [
                "to-string",
                ["get", "ele"]
              ],
              " m"
            ],
            ""
