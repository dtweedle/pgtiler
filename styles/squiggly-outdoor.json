{
  "version": 8,
  "name": "Squiggly Outdoor",
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "sources": {
    "base": {
      "type": "vector",
      "url": "https://maps.tweed.nz/squiggly.v1.base.json"
    },
    "contours": {
      "type": "vector",
      "url": "https://maps.tweed.nz/squiggly.v1.contours.json"
    },
    "hillshade": {
      "type": "raster-dem",
      "url": "https://maps.tweed.nz/squiggly.v1.terrain.json",
      "encoding": "terrarium",
      "tileSize": 512
    },
    "terrain": {
      "type": "raster-dem",
      "url": "https://maps.tweed.nz/squiggly.v1.terrain.json",
      "encoding": "terrarium",
      "tileSize": 512
