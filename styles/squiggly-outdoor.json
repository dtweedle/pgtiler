      "id": "bg",
      "type": "background",
      "paint": {
        "background-color": "#e8e0cf",
        "background-opacity": 1
      }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "hillshade",
      "paint": {
        "hillshade-exaggeration": 0.5,
        "hillshade-shadow-color": "#473B24",
        "hillshade-highlight-color": "#f6f0df",
        "hillshade-accent-color": "#8f7a57",
        "hillshade-illumination-direction": 315
      }
    },
    {
      "id": "park-fill",
      "type": "fill",
      "source": "base",
      "source-layer": "park",
      "paint": {
        "fill-color": "#cfe0bb",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          0.6,
          14,
          0.4
        ]
      },
      "layout": {
        "visibility": "visible"
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "base",
      "source-layer": "landcover",
